# Build-time defaults for the app: the server a fresh device starts with.
# Copy to ProjectManagerApp/.env.local (never committed) or set them as
# variables of the GitHub Pages build. Each device can still change the
# server in Settings → Server (docs/08-server-setup.md).
# The key is the PUBLIC one (ANON_KEY / publishable key) — never the
# service_role / secret key.
VITE_SUPABASE_URL=https://your-laptop.your-tailnet.ts.net
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-here
